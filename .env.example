# =============================================================================
# RH AI Agent - example environment file
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database ---
# Local PostgreSQL with pgvector extension enabled.
# Special chars must be percent-encoded (e.g. @ -> %40).
DATABASE_URL=postgres://postgres:change-me-password@localhost:5432/desafio

# --- Security ---
# Comma-separated list of allowed origins for the chat API. Never use "*".
ALLOWED_ORIGINS=http://localhost:3000
# Max length (chars) allowed for a user question.
MAX_QUESTION_LENGTH=2000
# Max upload size in megabytes for the document upload API.
MAX_UPLOAD_SIZE_MB=10

# --- AI provider (OpenAI-compatible) ---
# Works with OpenAI, OpenRouter, Groq, Together, Azure OpenAI, etc.
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=your-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Embedding dimension must match the model (1536 for text-embedding-3-small).
EMBEDDING_DIMENSIONS=1536

# --- RAG ---
RAG_TOP_K=5
RAG_MIN_SCORE=0.25
MAX_CONTEXT_CHARS=12000
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=80

# --- Cost estimation (USD per 1M tokens) ---
# Set to your provider's real prices. Placeholders below match OpenAI gpt-4o-mini
# and text-embedding-3-small at the time of writing.
LLM_INPUT_COST_PER_1M_TOKENS=0.15
LLM_OUTPUT_COST_PER_1M_TOKENS=0.60
EMBEDDING_COST_PER_1M_TOKENS=0.02

# --- Logging ---
LOG_LEVEL=info
